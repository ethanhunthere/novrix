# NOVRIX — Environment / Secret Reference
# DO NOT commit real values. This file lists every name; each value must
# be stored as a Cloudflare secret (`wrangler pages secret put` for
# Pages Functions, `wrangler secret put` for Workers).

# ─── Pages Functions (apex `novrixhere` project) ─────────────────────────────
# Auth
AUTH_PEPPER=                      # 32+ random bytes; server-side pepper for HMAC-SHA-256 of NOVRIX IDs
ALLOWED_ORIGIN=                   # comma-separated allow-list, e.g. https://novrix.io,https://www.novrix.io

# Posts admin
POST_ADMIN_SECRET=                # required by POST /api/posts/create header X-Post-Secret

# Indicator seed admin
SEED_ADMIN_SECRET=                # required by every POST /api/*/seed header X-Seed-Secret

# 3rd-party data sources
FRED_API_KEY=                     # St. Louis Fed (macro indicators)
BGEOMETRICS_API_KEY_2=            # bitcoin-data.com (history seeders + crons)
BGEOMETRICS_API_KEY_3=            # bitcoin-data.com (sentiment cron)
BGEOMETRICS_API_KEY_4=            # bitcoin-data.com (sentiment cron)
BGEOMETRICS_API_KEY_5=            # bitcoin-data.com (sentiment cron)
CMC_API_KEY=                      # CoinMarketCap (dominance, market cap)
HELIUS_API_KEY=                   # Solana whale tracking

# ─── Workers (each cron has its own secret store) ────────────────────────────
# workers/fred-cron        → FRED_API_KEY
# workers/sentiment-cron   → BGEOMETRICS_API_KEY_3, _4, _5, CMC_API_KEY
# workers/news-cron        → (no secrets currently)
# workers/tracking-cron    → HELIUS_API_KEY
# workers/metrilytics-cron → BGEOMETRICS_API_KEY_2

# ─── Local development ──────────────────────────────────────────────────────
# `wrangler pages dev` will source these from `.dev.vars` (gitignored).
# Create that file from the names above, never from real production values.
